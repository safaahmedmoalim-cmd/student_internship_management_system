# Copy this file to ".env" and adjust the values. Never commit the real .env.

# --- Core ---------------------------------------------------------------------
DJANGO_DEBUG=True
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Frontend -------------------------------------------------------------------
# Origin(s) the React app is served from, and the URL used in password-reset emails.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) -------------------------------------------------------
# createdb -U postgres student_internship_management
DB_ENGINE=postgres
DB_NAME=student_internship_management
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# DB_ENGINE=sqlite uses DB_SQLITE_FILE instead (quick experiments only).
# DB_SQLITE_FILE=dev.sqlite3

# --- JWT authentication ------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1
AUTH_THROTTLE_RATE=20/min

# --- Uploads ---------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# --- Email (password reset links). Console backend prints emails in the terminal. ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=attachment-system@langata.ac.ke

# --- Production (DJANGO_DEBUG=False) --------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
