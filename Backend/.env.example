# Copy this file to ".env" and adjust the values.

# --- Core ---------------------------------------------------------------
DJANGO_DEBUG=True
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS (the origin(s) your frontend is served from) --------------------
# In DEBUG every origin is allowed. In production list them explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=

# --- Portal rules ---------------------------------------------------------
# Code a person must enter to register as a Coordinator. Leave empty to disable
# coordinator self-registration (create them with `createsuperuser` instead).
COORDINATOR_ACCESS_CODE=LANGATA-COORD
# Hours a student must complete (used for progress bars)
TARGET_HOURS=400

# --- Database -------------------------------------------------------------
# DB_ENGINE: sqlite (default, no setup) | mysql | postgres
DB_ENGINE=sqlite
# For MySQL: create an EMPTY database first  ->  CREATE DATABASE langata_django CHARACTER SET utf8mb4;
DB_NAME=langata_django
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
